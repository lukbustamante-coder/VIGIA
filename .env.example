# Copy to .env locally. Never commit populated credentials.
# Load with: set -a; . ./.env; set +a (only source your own trusted file).
VIGIA_SECRET_KEY=
VIGIA_DEBUG=true
VIGIA_ALLOWED_HOSTS=localhost,127.0.0.1
VIGIA_CSRF_ORIGINS=http://localhost:8000
OIDC_ISSUER=https://sso.example.org/realms/empresa
OIDC_CLIENT_ID=vigia
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/auth/callback/
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:8000/auth/logout/callback/
OIDC_ADMIN_ROLE=vigia-admin
# Optional. By default VT only looks up hashes.
VT_API_KEY=
# Enable only after reviewing terms/privacy. Each upload also requires the user's checkbox.
VT_ALLOW_SAMPLE_UPLOAD=false
# Optional URL scans. The URL form queries reputation automatically on submit.
# When enabled, previously unknown URLs are submitted automatically for analysis.
VT_ALLOW_URL_SUBMISSION=false
# Consultas individuales de enlaces y adjuntos EML; requiere autorización en cada carga.
VT_ALLOW_EMAIL_RESOURCES=false
# Free basic account lookup, no key. Use disabled to turn it off, or hibp for paid HIBP API.
BREACH_PROVIDER=xposedornot
# Optional paid alternative; not used when BREACH_PROVIDER=xposedornot.
HIBP_ENABLED=false
HIBP_API_KEY=
# Optional. Choose openai, gemini or disabled. Only one is called per analysis.
AI_PROVIDER=openai
# OpenAI key (OPENAI_API_KEY is also supported for email reports).
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
# Gemini is used for email reports when AI_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Institutional policy: selected EML headers are sent automatically when true.
# When false, AI receives technical summaries only. No per-upload AI checkbox.
# Header sharing may disclose names, addresses, subject and routing IPs.
# The email body, attachment bytes and full DKIM signatures are never sent to AI.
AI_ALLOW_HEADER_UPLOAD=false
# Optional DNS-only checks for EML. Each upload requires a separate consent checkbox.
# Uses Authorization: <key> without Bearer. Never put the key in a URL.
MXTOOLBOX_ENABLED=false
MXTOOLBOX_API_KEY=

# Reportes a soporte SISEI e infraestructura. Completar con los datos de TI.
# Dejar false hasta configurar y probar el SMTP. No compartir ni subir las credenciales.
REPORT_MAIL_ENABLED=false
# Nombre del servidor SMTP institucional (ejemplo: smtp.institucion.cl).
EMAIL_HOST=
# 587 normalmente usa STARTTLS; 465 usa SSL. Confirmar con TI.
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
# Si el relay no requiere autenticación, dejar usuario y contraseña vacíos.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Dirección remitente autorizada por el servidor institucional.
DEFAULT_FROM_EMAIL=
